<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suivi des Infractions</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
    </style>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow p-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-[var(--couleur-bleue)]">Suivi de Toutes les Infractions</h1>
        <div class="text-right">
            <a href="/admin/dashboard" class="text-sm text-gray-600 hover:underline">← Retour au tableau de bord</a>
        </div>
    </header>

    <main class="container mx-auto p-6">
        <div class="bg-white shadow-xl rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px]">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Citoyen (CNI)</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Plaque</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Montant</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Agent</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% if (infractions.length === 0) { %>
                            <tr>
                                <td colspan="7" class="p-6 text-center text-gray-500">
                                    Aucune infraction n'a été enregistrée dans le système.
                                </td>
                            </tr>
                        <% } else { %>
                            <% infractions.forEach(inf => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="py-4 px-4 text-sm font-medium text-gray-900"><%= inf.id %></td>
                                    <td class="py-4 px-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-900"><%= inf.citoyenConcerne?.nom_complet || 'N/A' %></div>
                                        <div class="text-xs text-gray-500"><%= inf.citoyenConcerne?.cni || 'N/A' %></div>
                                    </td>
                                    <td class="py-4 px-4 text-sm font-mono text-gray-700"><%= inf.plaque_immatriculation %></td>
                                    <td class="py-4 px-4 text-sm text-gray-800"><%= inf.type?.nom || 'N/A' %></td>
                                    <td class="py-4 px-4 text-sm font-semibold text-gray-900"><%= parseFloat(inf.montant_actuel).toLocaleString('fr-FR') %> XAF</td>
                                    <td class="py-4 px-4">
                                        <% if (inf.statut === 'payee') { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-green-800 bg-green-100 rounded-full">Payée</span>
                                        <% } else if (inf.statut === 'en_retard') { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-red-800 bg-red-100 rounded-full">En Retard</span>
                                        <% } else { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-yellow-800 bg-yellow-100 rounded-full">En Attente</span>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-4 text-sm text-gray-600"><%= inf.agentVerbalisateur?.username || 'N/A' %></td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>