<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de Bord Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin-style.css">
    
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
    </style>

</head>
<body class="bg-gray-100">
    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="bg-white shadow p-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold text-[var(--couleur-bleue)]">Tableau de Bord</h1>
            <div class="text-right">
                <p class="font-semibold"><%= userAdmin.username %></p>
                <p class="text-sm text-gray-600"><%= userAdmin.role %></p>
                <a href="/logout" class="text-sm text-red-500 hover:underline">Se déconnecter</a>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow p-6">
            <h2 class="text-xl font-semibold mb-4">Fonctionnalités</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- Lien pour Agent Verbalisateur -->
                <% if (userAdmin.role === 'agent_verbalisateur' || userAdmin.role === 'administrateur') { %>
                    <a href="/admin/infraction/new" class="block p-6 bg-white rounded-xl shadow hover:shadow-lg transition-shadow">
                        <div class="flex items-center justify-center h-12 w-12 rounded-full bg-[var(--couleur-verte)] text-white mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Nouvelle Infraction</h3>
                        <p class="text-gray-600 text-sm">Enregistrer une nouvelle infraction routière.</p>
                    </a>
                <% } %>

                <!-- MISE À JOUR : Lien pour Agent de Contrôle -->
                <% if (userAdmin.role === 'agent_controle' || userAdmin.role === 'administrateur') { %>
                    <a href="/admin/infractions" class="block p-6 bg-white rounded-xl shadow hover:shadow-lg transition-shadow">
                        <div class="flex items-center justify-center h-12 w-12 rounded-full bg-[var(--couleur-bleue)] text-white mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Suivi des Infractions</h3>
                        <p class="text-gray-600 text-sm">Voir toutes les infractions enregistrées.</p>
                    </a>
                <% } %>
                
                <!-- NOUVEAU: Lien pour Administrateur -->
                <% if (userAdmin.role === 'administrateur') { %>
                    <a href="/admin/penalties" class="block p-6 bg-white rounded-xl shadow hover:shadow-lg transition-shadow">
                        <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gray-700 text-white mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold mb-2">Règles de Pénalité</h3>
                        <p class="text-gray-600 text-sm">Configurer les règles de pénalité de retard.</p>
                    </a>
                <% } %>

            </div>
        </main>
    </div>
</body>
</html>