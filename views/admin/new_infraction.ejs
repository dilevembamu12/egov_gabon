<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle Infraction</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin-style.css">
    <!-- NOUVEAU : Bibliothèque de scan QR -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
        /* Style pour le lecteur QR */
        #qr-reader {
            width: 100%;
            max-width: 400px;
            margin: 10px auto;
            border: 2px dashed #a0aec0;
            border-radius: 8px;
        }
        #qr-reader__scan_region {
            background: rgba(0,0,0,0.1);
        }
        .btn-primary {
            background-color: var(--couleur-bleue);
        }
        .btn-primary:hover {
            background-color: #002269;
        }
        .btn-secondary {
             background-color: #64748b;
        }
         .btn-secondary:hover {
             background-color: #475569;
         }
    </style>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow p-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-[var(--couleur-bleue)]">Nouvelle Infraction</h1>
        <div class="text-right">
            <a href="/admin/dashboard" class="text-sm text-gray-600 hover:underline">← Retour au tableau de bord</a>
        </div>
    </header>

    <!-- Formulaire principal (Wizard) -->
    <div class="max-w-2xl mx-auto p-6">
        <div class="bg-white shadow-xl rounded-xl p-8">
            
            <!-- Affichage des messages de succès ou d'erreur globaux -->
            <% if (locals.success) { %>
                <div class="p-4 mb-4 text-sm text-green-700 bg-green-100 border border-green-200 rounded-md">
                    <%= success %>
                </div>
            <% } %>
            <% if (locals.error && !locals.cniError) { %> <!-- N'affiche que si ce n'est pas une erreur CNI gérée ci-dessous -->
                <div class="p-4 mb-4 text-sm text-red-700 bg-red-100 border border-red-200 rounded-md">
                    <%= error %>
                </div>
            <% } %>

            <!-- ÉTAPE 1: Scan CNI -->
            <div id="step-1">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Étape 1 : Identification du Citoyen</h2>
                <div id="qr-reader" class="mb-4"></div>
                <button type="button" id="start-scan-btn" class="w-full px-4 py-3 font-semibold text-white bg-[var(--couleur-verte)] rounded-md hover:bg-opacity-90 transition-colors">
                    <i class="fas fa-qrcode mr-2"></i> Démarrer le Scan
                </button>

                <div class="my-4 text-center text-gray-500">ou</div>
                
                <!-- Section Manuelle -->
                <div class="bg-gray-50 p-4 rounded-md border">
                    <label for="cni_manual" class="block text-sm font-medium text-gray-700">Entrer le N° CNI manuellement</label>
                    <div class="flex gap-2 mt-1">
                        <input id="cni_manual" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-bleue)]" placeholder="Ex: 0101123456">
                        <button type="button" id="verify-cni-btn" class="px-4 py-2 font-semibold text-white btn-primary rounded-md">Vérifier</button>
                    </div>
                </div>

                <!-- Zone de message pour l'Étape 1 -->
                <div id="step-1-message" class="mt-4 text-center"></div>
            </div>

            <!-- ÉTAPE 2: Détails Infraction (Cachée par défaut) -->
            <form id="step-2" class="space-y-5 hidden" action="/admin/infraction/new" method="POST">
                <h2 class="text-xl font-semibold text-gray-800 mb-4">Étape 2 : Détails de l'Infraction</h2>

                <!-- Info Citoyen (pré-remplie) -->
                <fieldset class="bg-blue-50 border border-blue-200 p-4 rounded-md">
                    <legend class="font-semibold text-blue-800">Citoyen identifié</legend>
                    <div class="mb-2">
                        <label class="block text-sm font-medium text-gray-700">N° CNI</label>
                        <input id="cni_citoyen_display" name="cni_citoyen" type="text" readonly class="w-full px-4 py-2 mt-1 bg-gray-200 border border-gray-300 rounded-md">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Nom Complet</label>
                        <input id="nom_citoyen_display" name="nom_citoyen" type="text" readonly class="w-full px-4 py-2 mt-1 bg-gray-200 border border-gray-300 rounded-md">
                    </div>
                </fieldset>

                <!-- Champ Plaque d'immatriculation -->
                <div>
                    <label for="plaque" class="block text-sm font-medium text-gray-700">Plaque d'immatriculation</label>
                    <input id="plaque" name="plaque" type="text" required class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-bleue)]" placeholder="Ex: AB-123-CD">
                </div>

                <!-- Champ Type d'infraction (Dynamique) -->
                <div>
                    <label for="infractionTypeId" class="block text-sm font-medium text-gray-700">Type d'infraction</label>
                    <select id="infractionTypeId" name="infractionTypeId" required class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-bleue)]">
                        <option value="">-- Sélectionner un type --</option>
                        <% if (locals.infractionTypes && infractionTypes.length) { %>
                            <% infractionTypes.forEach(type => { %>
                                <option value="<%= type.id %>">
                                    <%= type.nom %> (<%= parseFloat(type.montant_base).toLocaleString('fr-FR') %> XAF)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <!-- Champ Procès Verbal (Notes) -->
                <div>
                    <label for="proces_verbal" class="block text-sm font-medium text-gray-700">Procès Verbal (Notes)</label>
                    <textarea id="proces_verbal" name="proces_verbal" rows="4" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-bleue)]" placeholder="Notes de l'agent, description..."></textarea>
                </div>

                <!-- Champ Photos (Simulation) -->
                <div>
                    <label for="photos_url" class="block text-sm font-medium text-gray-700">Lien vers Photo (Simulation TPE)</label>
                    <input id="photos_url" name="photos_url" type="text" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-bleue)]" placeholder="https://lien.vers/image.jpg">
                </div>

                <!-- Boutons de soumission -->
                <div class="flex gap-4">
                    <button type="button" onclick="resetForm()" class="w-1/2 px-4 py-3 font-semibold text-white btn-secondary rounded-md hover:bg-opacity-90 transition-colors">
                        Annuler (Scanner à nouveau)
                    </button>
                    <button type="submit" class="w-1/2 px-4 py-3 font-semibold text-white bg-[var(--couleur-verte)] rounded-md hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--couleur-verte)] focus:ring-offset-2 transition-colors">
                        Enregistrer l'infraction
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const step1 = document.getElementById('step-1');
        const step2 = document.getElementById('step-2');
        const startScanBtn = document.getElementById('start-scan-btn');
        const verifyCniBtn = document.getElementById('verify-cni-btn');
        const cniManualInput = document.getElementById('cni_manual');
        const step1Message = document.getElementById('step-1-message');
        let html5QrCode;

        // Fonction pour afficher les messages à l'étape 1
        function showMessage(text, isError = false) {
            step1Message.textContent = text;
            step1Message.className = isError ? 'mt-4 text-center text-red-600' : 'mt-4 text-center text-green-600';
        }

        // Fonction pour passer à l'étape 2
        function goToStep2(cni, nom) {
            document.getElementById('cni_citoyen_display').value = cni;
            document.getElementById('nom_citoyen_display').value = nom;
            step1.classList.add('hidden');
            step2.classList.remove('hidden');
            stopScan(); // Arrêter la caméra
        }

        // Fonction pour réinitialiser le formulaire
        function resetForm() {
            step2.classList.add('hidden');
            step1.classList.remove('hidden');
            document.getElementById('dynamic-form').reset();
            cniManualInput.value = '';
            showMessage('');
        }

        // Fonction pour vérifier la CNI auprès du serveur
        async function verifyCni(cni) {
            if (!cni) {
                showMessage('Le N° CNI est vide.', true);
                return;
            }
            
            showMessage('Vérification du N° CNI en cours...', false);
            verifyCniBtn.disabled = true;

            try {
                const response = await fetch('/api/citizen/check-cni', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cni: cni })
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || 'Erreur inconnue');
                }
                
                // Succès !
                showMessage(`Citoyen trouvé : ${result.citoyen.nom_complet}`, false);
                setTimeout(() => {
                    goToStep2(result.citoyen.cni, result.citoyen.nom_complet);
                }, 1000); // Court délai pour voir le message de succès

            } catch (error) {
                showMessage(error.message, true);
            } finally {
                verifyCniBtn.disabled = false;
            }
        }

        // --- Logique du Scanner QR ---
        function onScanSuccess(decodedText, decodedResult) {
            console.log(`Code scanné = ${decodedText}`);
            try {
                const data = JSON.parse(decodedText);
                if (data.cni) {
                    showMessage('QR Code lu. Vérification du citoyen...', false);
                    cniManualInput.value = data.cni; // Pré-remplir le champ manuel
                    verifyCni(data.cni);
                } else {
                    showMessage('QR Code invalide (champ "cni" manquant). Réessayez ou entrez manuellement.', true);
                }
            } catch (e) {
                showMessage('QR Code non reconnu (format JSON invalide). Réessayez ou entrez manuellement.', true);
            }
        }

        function onScanFailure(error) {
            // console.warn(`Erreur de scan = ${error}`);
        }

        function startScan() {
            if (!html5QrCode) {
                html5QrCode = new Html5Qrcode("qr-reader");
            }
            startScanBtn.textContent = 'Scan en cours...';
            startScanBtn.disabled = true;

            html5QrCode.start(
                { facingMode: "environment" }, // Préfère la caméra arrière
                {
                    fps: 10, // 10 images par seconde
                    qrbox: { width: 250, height: 250 } // Fenêtre de scan
                },
                onScanSuccess,
                onScanFailure
            ).catch(err => {
                showMessage('Impossible d\'accéder à la caméra. Vérifiez les permissions.', true);
                startScanBtn.textContent = 'Démarrer le Scan';
                startScanBtn.disabled = false;
            });
        }

        function stopScan() {
            if (html5QrCode && html5QrCode.isScanning) {
                html5QrCode.stop().then(() => {
                    console.log("Scan arrêté.");
                }).catch(err => {
                    console.warn("Échec de l'arrêt du scan.", err);
                });
            }
            startScanBtn.textContent = 'Démarrer le Scan';
            startScanBtn.disabled = false;
        }

        // --- Écouteurs d'événements ---
        startScanBtn.addEventListener('click', startScan);
        verifyCniBtn.addEventListener('click', () => {
            verifyCni(cniManualInput.value.trim());
        });

    </script>
</body>
</html>