<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Pénalités</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
    </style>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow p-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold text-[var(--couleur-bleue)]">Gestion des Règles de Pénalité</h1>
        <div class="text-right">
            <a href="/admin/dashboard" class="text-sm text-gray-600 hover:underline">← Retour au tableau de bord</a>
        </div>
    </header>

    <main class="container mx-auto p-6">
        <div class="bg-white shadow-xl rounded-xl overflow-hidden">
            <div class="p-6 border-b">
                <h2 class="text-xl font-semibold">Règles Actives</h2>
                <p class="text-sm text-gray-600 mt-1">Ces règles s'appliquent automatiquement aux infractions en retard.</p>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[600px]">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Condition (Jours de retard)</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Type de Pénalité</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Valeur</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% if (rules.length === 0) { %>
                            <tr>
                                <td colspan="4" class="p-6 text-center text-gray-500">
                                    Aucune règle de pénalité n'est configurée.
                                </td>
                            </tr>
                        <% } else { %>
                            <% rules.forEach(rule => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="py-4 px-4 text-sm font-medium text-gray-900"><%= rule.id %></td>
                                    <td class="py-4 px-4 text-sm text-gray-800">Après <%= rule.jours_apres_delai %> jours</td>
                                    <td class="py-4 px-4 text-sm text-gray-800"><%= rule.type_penalite %></td>
                                    <td class="py-4 px-4 text-sm font-semibold text-gray-900">
                                        <% if (rule.type_penalite === 'fixe') { %>
                                            <%= parseFloat(rule.valeur).toLocaleString('fr-FR') %> XAF
                                        <% } else { %>
                                            <%= rule.valeur %>%
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>