<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - Espace Citoyen</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    
    <div class="w-full max-w-md">
        <div class="bg-white shadow-xl rounded-xl p-8">
            <div class="flex flex-col items-center mb-6">
                <img src="/img/coat_of_arms.jpg" alt="Armoiries du Gabon" class="h-20 w-auto mb-4">
                <h2 class="text-2xl font-bold text-center text-gray-900">Espace Citoyen</h2>
                <p class="text-gray-600">Bienvenue sur votre portail e-Gouv</p>
            </div>
            
            <form class="space-y-5" action="/login" method="POST">
                <div>
                    <label for="cni" class="block text-sm font-medium text-gray-700">Numéro de CNI</label>
                    <input id="cni" name="cni" type="text" required class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-verte)] focus:border-transparent" placeholder="Ex: 0101123456">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700">Mot de passe</label>
                    <input id="password" name="password" type="password" required class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-[var(--couleur-verte)] focus:border-transparent">
                </div>
                
                <% if (error) { %>
                    <p class="text-sm text-red-600 p-3 bg-red-50 border border-red-200 rounded-md"><%= error %></p>
                <% } %>
                
                <div>
                    <button type="submit" class="w-full px-4 py-3 font-semibold text-white bg-[var(--couleur-verte)] rounded-md hover:bg-opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--couleur-verte)] focus:ring-offset-2 transition-colors">
                        Connexion
                    </button>
                </div>
            </form>
        </div>
        <p class="text-center text-sm text-gray-500 mt-4">
            <a href="/admin/login" class="hover:underline">Accès administration</a>
        </p>
    </div>

</body>
</html>