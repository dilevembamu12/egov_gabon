<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Espace - eGouv Gabon</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --couleur-verte: #009E60;
            --couleur-jaune: #FCD116;
            --couleur-bleue: #0033A0;
        }
    </style>
</head>
<body class="bg-gray-100">
    <!-- Header -->
    <header class="bg-white shadow p-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <img src="/img/coat_of_arms.jpg" alt="Armoiries" class="h-10 w-auto">
            <h1 class="text-2xl font-bold text-[var(--couleur-bleue)]">Mon Espace Citoyen</h1>
        </div>
        <div class="text-right">
            <p class="font-semibold"><%= userCitizen.nom_complet %></p>
            <p class="text-sm text-gray-600">CNI: <%= userCitizen.cni %></p>
            <a href="/logout" class="text-sm text-red-500 hover:underline">Se déconnecter</a>
        </div>
    </header>

    <main class="container mx-auto p-6">
        
        <!-- Cartes de résumé -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-6 rounded-lg shadow">
                <div class="text-3xl font-bold"><%= total_a_payer.toLocaleString('fr-FR') %> XAF</div>
                <div class="text-sm font-medium uppercase">Total à Payer</div>
                <p class="text-xs mt-1">Total de vos infractions en attente ou en retard.</p>
            </div>
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-6 rounded-lg shadow">
                <div class="text-3xl font-bold"><%= total_paye.toLocaleString('fr-FR') %> XAF</div>
                <div class="text-sm font-medium uppercase">Total Payé</div>
                <p class="text-xs mt-1">Historique de vos paiements d'infractions.</p>
            </div>
        </div>

        <!-- Tableau des infractions -->
        <div class="bg-white shadow-xl rounded-xl overflow-hidden">
            <div class="p-6 border-b">
                <h2 class="text-xl font-semibold">Mes Infractions</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px]">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Plaque</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Type d'Infraction</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Montant</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Statut</th>
                            <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        <% if (infractions.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-6 text-center text-gray-500">
                                    Félicitations, vous n'avez aucune infraction enregistrée.
                                </td>
                            </tr>
                        <% } else { %>
                            <% infractions.forEach(inf => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="py-4 px-4 whitespace-nowrap">
                                        <div class="text-sm font-medium text-gray-900"><%= new Date(inf.date_emission).toLocaleDateString('fr-FR') %></div>
                                        <div class="text-xs text-gray-500">Délai: <%= new Date(inf.date_limite_paiement).toLocaleDateString('fr-FR') %></div>
                                    </td>
                                    <td class="py-4 px-4 text-sm font-mono text-gray-700"><%= inf.plaque_immatriculation %></td>
                                    <td class="py-4 px-4 text-sm text-gray-800"><%= inf.type.nom %></td>
                                    <td class="py-4 px-4 text-sm font-semibold text-gray-900"><%= parseFloat(inf.montant_actuel).toLocaleString('fr-FR') %> XAF</td>
                                    <td class="py-4 px-4">
                                        <% if (inf.statut === 'payee') { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-green-800 bg-green-100 rounded-full">Payée</span>
                                        <% } else if (inf.statut === 'en_retard') { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-red-800 bg-red-100 rounded-full">En Retard</span>
                                        <% } else { %>
                                            <span class="px-3 py-1 text-xs font-semibold text-yellow-800 bg-yellow-100 rounded-full">En Attente</span>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-4">
                                        <% if (inf.statut !== 'payee') { %>
                                            <a href="/citizen/pay/<%= inf.id %>" class="px-4 py-2 text-sm font-medium text-white bg-[var(--couleur-verte)] rounded-md hover:bg-opacity-90 transition-colors">
                                                Payer
                                            </a>
                                        <% } else { %>
                                            <span class="text-sm text-gray-400">Réglée</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</body>
</html>